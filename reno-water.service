[Unit]
Description=RENO Water Treatment System
After=network.target
# Give USB devices time to settle after boot
After=dev-ttyUSB0.device
Wants=dev-ttyUSB0.device

[Service]
Type=simple
User=suprabha
Group=suprabha

WorkingDirectory=/home/suprabha/full_system
ExecStart=/home/suprabha/full_system/venv/bin/python run.py

# Restart automatically on failure
Restart=on-failure
RestartSec=5

# Give the USB port time to become available before first start
ExecStartPre=/bin/sleep 3

# Log stdout/stderr to journald (view with: journalctl -u reno-water -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
